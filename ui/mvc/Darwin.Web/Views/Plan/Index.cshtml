@model List<PlanViewModel>

<div class="container">

    <div class="row">
        <div class="col">
            <h2 class="">Üyelik Planları</h2>
        </div>
        <div class="col">
            <a class="btn btn-primary float-end" asp-action="Create">Ekle</a>
        </div>
    </div>
@if(Model.Count>0)
{
    <div class="row">
        @foreach (var item in Model)
        {
        <div class="col-sm-4 mb-3 mb-sm-0">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text">@item.Description</p>
                    <p>@item.Id</p>
                    <button class="btn btn-sm btn-primary float-end">@item.Price TL</button>   
                </div>
            </div>
        </div>
        }
    </div>
}
else
{
    <h2 class="bg-warning badge">Herhangi bir üyelik türü bulunamadı.Standart üyelik kullanıyorsunuz.</h2>
}
</div>