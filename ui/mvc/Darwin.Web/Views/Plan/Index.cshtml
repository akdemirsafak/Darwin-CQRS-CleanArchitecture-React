@model List<PlanViewModel>


@if(Model.Count>0)
{
    <div class="row">
        @foreach (var item in Model)
        {
        <div class="col-sm-4 mb-3 mb-sm-0">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text">@item.Description</p>
                    <p>@item.Id</p>
                    <button class="btn btn-sm btn-primary float-end">@item.Price TL</button>   
                </div>
            </div>
        </div>
        }
    </div>
}
else
{
    <h2>There is no plan</h2>
}
