@model PlanViewModel


@{
    ViewBag.Title = "Detaylar";
}

<h2>Üyelik türü detayı</h2>

<div>
    <h4>Plan</h4>
    <hr />
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">@Model.Name</h5>
            <p>@Model.Description</p>
            <p>@Model.Price</p>
            @Model.IsActive ? <p>Active</p> : <p>Passive</p>
        </div>
</div>